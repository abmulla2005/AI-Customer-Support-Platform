# AI Customer Support Platform - Environment Configuration

# Application
APP_NAME="AI Customer Support Platform"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"

# MongoDB Atlas Connection
# Replace with your Atlas connection string: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="ai_support_platform"

# Authentication Secrets (Generate strong 64-character random hex keys for production)
JWT_SECRET="changethis_super_secret_jwt_access_key_minimum_32_characters_long_12345"
JWT_REFRESH_SECRET="changethis_super_secret_jwt_refresh_key_minimum_32_characters_long_12345"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Administrator Seed (Automatically provisioned on first startup if no admin exists)
INITIAL_ADMIN_EMAIL="admin@aisupport.com"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword123!"
INITIAL_ADMIN_NAME="System Administrator"

# LLM Configuration (OpenRouter)
# Get a key from https://openrouter.ai/
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3-haiku"
# Alternative models: "openai/gpt-4o-mini", "meta-llama/llama-3-8b-instruct", "google/gemini-flash-1.5"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Embeddings Configuration
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# RAG & Document Processing
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Email / SMTP (Optional for reset password notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="support@aisupport.local"
